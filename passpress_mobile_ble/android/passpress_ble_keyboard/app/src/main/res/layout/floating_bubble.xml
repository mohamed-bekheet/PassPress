<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Expanded Menu (Hidden by default) -->
    <LinearLayout
        android:id="@+id/bubble_expanded_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#E60F172A"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="40dp">

        <Button
            android:id="@+id/btn_bubble_s1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="1"
            android:textColor="#FFFFFF"
            android:background="#334155"
            android:layout_marginEnd="4dp"/>
            
        <Button
            android:id="@+id/btn_bubble_s2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="2"
            android:textColor="#FFFFFF"
            android:background="#334155"
            android:layout_marginEnd="4dp"/>
            
        <Button
            android:id="@+id/btn_bubble_s3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="3"
            android:textColor="#FFFFFF"
            android:background="#334155"
            android:layout_marginEnd="4dp"/>
            
        <Button
            android:id="@+id/btn_bubble_s4"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="4"
            android:textColor="#FFFFFF"
            android:background="#334155"
            android:layout_marginEnd="4dp"/>
            
        <Button
            android:id="@+id/btn_bubble_s5"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="5"
            android:textColor="#FFFFFF"
            android:background="#334155"/>
    </LinearLayout>

    <!-- Main Bubble Icon -->
    <FrameLayout
        android:id="@+id/bubble_icon_container"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bubble_bg"
        android:elevation="4dp"
        android:layout_gravity="center_vertical|start">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌨️"
            android:textSize="24sp"
            android:layout_gravity="center"/>
    </FrameLayout>

</FrameLayout>
