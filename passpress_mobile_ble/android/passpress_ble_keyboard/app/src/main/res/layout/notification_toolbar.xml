<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="#0F172A">

    <TextView
        android:id="@+id/notif_status_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⌨️"
        android:textSize="20sp"
        android:layout_marginEnd="8dp"/>

    <Button
        android:id="@+id/btn_notif_connect"
        android:layout_width="0dp"
        android:layout_weight="1.2"
        android:layout_height="36dp"
        android:text="Connect"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/notif_btn_bg_accent"
        android:layout_marginEnd="8dp"/>

    <!-- Password Slots container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="3.8"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_notif_s1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:text="🔑1"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/notif_btn_bg"
            android:layout_marginEnd="4dp"/>
            
        <Button
            android:id="@+id/btn_notif_s2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:text="🔑2"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/notif_btn_bg"
            android:layout_marginEnd="4dp"/>
            
        <Button
            android:id="@+id/btn_notif_s3"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:text="🔑3"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/notif_btn_bg"
            android:layout_marginEnd="4dp"/>
            
        <Button
            android:id="@+id/btn_notif_s4"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:text="🔑4"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/notif_btn_bg"
            android:layout_marginEnd="4dp"/>
            
        <Button
            android:id="@+id/btn_notif_s5"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:text="🔑5"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/notif_btn_bg"/>

    </LinearLayout>

</LinearLayout>
